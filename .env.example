# =============================================================================
# XARE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# NOTE: Never commit real secrets to version control.

# -----------------------------------------------------------------------------
# 1. Cloud Object Storage (S3-Compatible: Cloudflare R2 / Backblaze B2 / AWS S3)
# -----------------------------------------------------------------------------
# For Cloudflare R2:
# STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_BUCKET=xare-files
# STORAGE_ACCESS_KEY_ID=<r2_access_key_id>
# STORAGE_SECRET_ACCESS_KEY=<r2_secret_access_key>
# STORAGE_PUBLIC_URL=https://<custom_domain_or_pub_r2_dev>

# For Backblaze B2:
# STORAGE_ENDPOINT=https://s3.<region>.backblazeb2.com
# STORAGE_REGION=us-east-005
# STORAGE_BUCKET=xare-files
# STORAGE_ACCESS_KEY_ID=<b2_key_id>
# STORAGE_SECRET_ACCESS_KEY=<b2_application_key>
# STORAGE_PUBLIC_URL=https://f005.backblazeb2.com/file/xare-files

# Generic S3 / MinIO:
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=xare-files
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=
STORAGE_FORCE_PATH_STYLE=false

# -----------------------------------------------------------------------------
# 2. AI & Audio Service Keys (Serverless Edge Functions)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
CHATBOT_TOKEN=ali1234
